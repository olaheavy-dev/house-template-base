{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] }
  },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": true,
        "required_status_checks": [
          { "context": "Render the template and test the hooks" },
          { "context": "Generated project passes its checks" },
          { "context": "actionlint" },
          { "context": "zizmor" },
          { "context": "Conventional Commits title" },
          { "context": "CodeQL (actions)" },
          { "context": "CodeQL (python)" }
        ]
      }
    },
    {
      "type": "code_scanning",
      "parameters": {
        "code_scanning_tools": [
          { "tool": "CodeQL", "alerts_threshold": "all", "security_alerts_threshold": "all" },
          { "tool": "zizmor", "alerts_threshold": "all", "security_alerts_threshold": "all" }
        ]
      }
    }
  ]
}
