# Owned by house-template-base. Each stack layer owns its own compose file next to its code
# (backend/compose.yaml, frontend/compose.yaml); this file only includes them, so `docker compose up`
# runs the whole project from the root. Included files keep their own project directory, and a
# service in one can depend on a service in another.
# Docs: https://docs.docker.com/reference/compose-file/include/ (needs Compose 2.20.3 or later)
name: {{ project_slug }}

include:
{%- if 'fastapi' in stacks %}
  - backend/compose.yaml
{%- endif %}
{%- if 'nextjs' in stacks %}
  - frontend/compose.yaml
{%- endif %}
