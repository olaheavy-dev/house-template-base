{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make check)",
      "Bash(make check-fast)",
      "Bash(make check-*)",
      "Bash(make test*)",
      "Bash(make template-status)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git switch -c *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh api -X *)",
      "Bash(gh api --method *)",
      "Bash(gh repo edit *)",
      "Bash(make repo-settings)",
      "Bash(copier *)",
      "Bash(uv add *)",
      "Bash(pnpm add *)",
      "Bash(npm install *)",
      "Bash(dotnet add *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.staging)",
      "Read(./.env.test)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.py"],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking the command against the repository's guardrails"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-files.py"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-checks.py"],
            "timeout": 600,
            "statusMessage": "Running make check-fast on the changes"
          }
        ]
      }
    ]
  }{% if agent_kit %},
  "extraKnownMarketplaces": {
    "{{ github_org }}": {
      "source": {
        "source": "github",
        "repo": "{{ github_org }}/agent-kit"
      }
    }
  },
  "enabledPlugins": {
    "agent-kit@{{ github_org }}": true
  }{% endif %}
}
