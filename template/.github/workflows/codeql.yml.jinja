# Owned by house-template-base. CodeQL for the workflows themselves and for each stack's language,
# chosen from the base answers (stacks). Every language uses build-mode none: no build step to keep
# in sync with the stack layers.
name: CodeQL

on:
  pull_request:
  push:
    branches: [main]
  schedule:
    - cron: "17 4 * * 1"

permissions: {}

concurrency:
  group: {{ '${{ github.workflow }}-${{ github.ref }}' }}
  cancel-in-progress: {{ "${{ github.event_name == 'pull_request' }}" }}

jobs:
  analyze:
    name: {{ 'CodeQL (${{ matrix.language }})' }}
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    permissions:
      contents: read
      security-events: write # upload results to code scanning
    strategy:
      fail-fast: false
      matrix:
        language:
          - actions
{%- if 'fastapi' in stacks %}
          - python
{%- endif %}
{%- if 'nextjs' in stacks %}
          - javascript-typescript
{%- endif %}
{%- if 'dotnet' in stacks %}
          - csharp
{%- endif %}
    steps:
      - name: Check out the repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Initialise CodeQL
        uses: github/codeql-action/init@9b3254085494b55a0f7c4c2b3d2d52cc712ce370 # v4.39.1
        with:
          languages: {{ '${{ matrix.language }}' }}
          build-mode: none
          queries: security-extended

      - name: Analyse
        uses: github/codeql-action/analyze@9b3254085494b55a0f7c4c2b3d2d52cc712ce370 # v4.39.1
        with:
          category: {{ '/language:${{ matrix.language }}' }}
