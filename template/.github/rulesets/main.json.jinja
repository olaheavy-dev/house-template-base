{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] }
  },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": true,
        "required_status_checks": [
          { "context": "make check" },
          { "context": "actionlint" },
          { "context": "zizmor" },
          { "context": "Dependency review" },
          { "context": "Conventional Commits title" },
          { "context": "CodeQL (actions)" }
{%- if 'fastapi' in stacks %},
          { "context": "CodeQL (python)" }
{%- endif %}
{%- if 'nextjs' in stacks %},
          { "context": "CodeQL (javascript-typescript)" }
{%- endif %}
{%- if 'dotnet' in stacks %},
          { "context": "CodeQL (csharp)" }
{%- endif %}
        ]
      }
    },
    {
      "type": "code_scanning",
      "parameters": {
        "code_scanning_tools": [
          { "tool": "CodeQL", "alerts_threshold": "errors", "security_alerts_threshold": "high_or_higher" },
          { "tool": "zizmor", "alerts_threshold": "errors_and_warnings", "security_alerts_threshold": "medium_or_higher" }
        ]
      }
    }
  ]
}
